# Stripe (test mode keys from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_...

# Resend (from https://resend.com/api-keys)
RESEND_API_KEY=re_...
# Must be a verified domain, or onboarding@resend.dev for testing
RESEND_FROM_ADDRESS="PropGuard <onboarding@resend.dev>"

# Used to build Stripe redirect / email links. Leave unset locally.
NEXT_PUBLIC_SITE_URL=https://propguard-azure.vercel.app
